// Cloudflare Worker for theskateworkshop.app, built by the OpenNext adapter
// (`npm run deploy`). Replaces the deprecated @cloudflare/next-on-pages, which
// cannot build Next 16. See https://opennext.js.org/cloudflare/get-started
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "skate-workshop-web",
  // Keep the workers.dev URL (testing/rollback) alongside the custom domains.
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The download page's pass code: how many tries are let through in a minute (src/lib/attempt-limit.ts).
  // namespace_id is any whole number of our own choosing, unique in the account.
  "ratelimits": [
    { "name": "DOWNLOAD_TRIES_PER_VISITOR", "namespace_id": "4801", "simple": { "limit": 5, "period": 60 } },
    { "name": "DOWNLOAD_TRIES_ALL", "namespace_id": "4802", "simple": { "limit": 120, "period": 60 } }
  ],
  "services": [
    // Must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "skate-workshop-web" }
  ],
  // Production traffic (2026-10-03): zone routes put this Worker in front of the
  // domain. The apex and www DNS records are proxied AAAA 100:: ("originless") — the
  // old Pages project was deleted, so nothing answers behind the Worker. Rollback =
  // previous Worker version (`npx wrangler rollback`), never "remove the routes",
  // which would take the site down. Zone has `always_use_https` ON.
  "routes": [
    { "pattern": "theskateworkshop.app/*", "zone_name": "theskateworkshop.app" },
    { "pattern": "www.theskateworkshop.app/*", "zone_name": "theskateworkshop.app" }
  ]
  // Deliberately not configured — each is a cost/account decision:
  // - "images": { "binding": "IMAGES" } turns on Cloudflare Images optimization (billed past the free tier).
  // - an R2 incremental cache; every page here is static or a plain API route, so none is needed.
}
